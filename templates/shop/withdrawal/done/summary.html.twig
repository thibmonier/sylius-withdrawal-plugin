{% set withdrawal_request = hookable_metadata.context.withdrawal_request %}

<div class="card">
    <div class="card-body">
        <p class="mb-3">{{ 'tmonier_withdrawal.ui.statement_text'|trans }}</p>
        <dl class="row mb-0">
            <dt class="col-sm-5">{{ 'tmonier_withdrawal.ui.reference'|trans }}</dt>
            <dd class="col-sm-7" {{ sylius_test_html_attribute('withdrawal-reference') }}>{{ withdrawal_request.reference }}</dd>
            <dt class="col-sm-5">{{ 'tmonier_withdrawal.form.customer_name'|trans }}</dt>
            <dd class="col-sm-7">{{ withdrawal_request.customerName }}</dd>
            <dt class="col-sm-5">{{ 'tmonier_withdrawal.form.order_number'|trans }}</dt>
            <dd class="col-sm-7">{{ withdrawal_request.orderNumber }}</dd>
            <dt class="col-sm-5">{{ 'tmonier_withdrawal.ui.scope'|trans }}</dt>
            <dd class="col-sm-7">
                {% if withdrawal_request.wholeContract %}
                    {{ 'tmonier_withdrawal.ui.whole_contract'|trans }}
                {% else %}
                    {% if withdrawal_request.hasItems %}
                        <ul class="mb-1 ps-3">
                            {% for item in withdrawal_request.items %}<li>{{ item.label }} × {{ item.quantity }}</li>{% endfor %}
                        </ul>
                    {% endif %}
                    {% if withdrawal_request.itemsDescription is not empty %}
                        <div class="text-break">{{ withdrawal_request.itemsDescription|nl2br }}</div>
                    {% endif %}
                {% endif %}
            </dd>
        </dl>
    </div>
</div>
