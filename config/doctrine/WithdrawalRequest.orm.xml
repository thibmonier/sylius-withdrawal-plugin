<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">

    <mapped-superclass name="Tmonier\SyliusWithdrawalPlugin\Entity\WithdrawalRequest" table="tmonier_withdrawal_request">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="reference" column="reference" type="string" length="32" unique="true" />
        <field name="state" column="state" type="string" length="32" />
        <field name="localeCode" column="locale_code" type="string" length="12" />
        <field name="customerName" column="customer_name" type="string" length="255" />
        <field name="email" column="email" type="string" length="255" />
        <field name="orderNumber" column="order_number" type="string" length="255" />
        <field name="itemsDescription" column="items_description" type="text" nullable="true" />
        <field name="submittedAt" column="submitted_at" type="datetime_immutable" />
        <field name="deadlineAt" column="deadline_at" type="datetime_immutable" nullable="true" />
        <field name="acknowledgedAt" column="acknowledged_at" type="datetime_immutable" nullable="true" />
        <field name="processedAt" column="processed_at" type="datetime_immutable" nullable="true" />

        <many-to-one field="channel" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>

        <many-to-one field="order" target-entity="Sylius\Component\Order\Model\OrderInterface">
            <join-column name="order_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <many-to-one field="customer" target-entity="Sylius\Component\Customer\Model\CustomerInterface">
            <join-column name="customer_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <one-to-many field="items" target-entity="Tmonier\SyliusWithdrawalPlugin\Entity\WithdrawalRequestItemInterface" mapped-by="withdrawalRequest" orphan-removal="true">
            <cascade>
                <cascade-all />
            </cascade>
        </one-to-many>

        <indexes>
            <index columns="state" />
            <index columns="submitted_at" />
        </indexes>
    </mapped-superclass>

</doctrine-mapping>
